    map <C-k> <Plug>(caw:hatpos:toggle)
endif

if g:plug.is_installed('easy-align')
    let g:easy_align_delimiters={'\\': {'pattern': '\\'}}
    xmap g= <Plug>(EasyAlign)
    xmap g\ <Plug>(EasyAlign)- 
endif

if g:plug.is_installed('fzf')
    nnoremap <silent>[Space]b :<C-u>Buffers<CR>
    nnoremap <silent>[Space]x :<C-u>Commands<CR>
    nnoremap <silent>[Space]f :<C-u>GFiles<CR>
    nnoremap <silent>[Space]F :<C-u>Files<CR>
    nnoremap <silent>[Space]r :<C-u>History:<CR>
    nnoremap <silent>[Space]a :<C-u>call fzf#vim#ag('', {'options': '--bind alt-enter:select-all+accept'})<CR>
    nnoremap <silent>[Space]/ :<C-u>call fzf#vim#buffer_lines('', {'options': '--bind alt-enter:select-all+accept'})<CR>
endif

if g:plug.is_installed('quickrun')
    nnoremap <silent>[Space]i :QuickRun -mode n<CR>
    vnoremap <silent>[Space]i :QuickRun -mode v<CR>
    let g:quickrun_no_default_key_mappings = 1
    let g:quickrun_config = {
                \   "_" : {
                \       "outputter/buffer/split" : ":botright",
                \       "outputter/buffer/close_on_empty" : 1
                \   },
                \}
endif


if g:plug.is_installed('asyncomplete')
    let g:asyncomplete_auto_completeopt = 0
endif

if g:plug.is_installed('lsp')
    aug Lsp
        au!
        if executable($HOME.'/virtualenv/vim/bin/pyls')
            au User lsp_setup call lsp#register_server({
                        \ 'name': 'pyls',
                        \ 'cmd': {server_info->[$HOME.'/virtualenv/vim/bin/pyls']},
                        \ 'whitelist': ['python'],
                        \ })
            au FileType python call s:configure_lsp()
        endif

        function! s:configure_lsp() abort
            setlocal omnifunc=lsp#complete
            nnoremap <silent> <buffer> <C-]> :<C-u>LspDefinition<CR>zz
            nnoremap <silent> <buffer> <C-w><C-]> :<C-u>sp<CR>:LspDefinition<CR>
            " nnoremap <silent> <buffer> <C-n> :<C-u>LspNextError<CR>
            " nnoremap <silent> <buffer> <C-p> :<C-u>LspPreviousError<CR>
            nnoremap <silent> <buffer> gD :<C-u>LspReferences<CR>
            " nnoremap <buffer> gs :<C-u>LspDocumentSymbol<CR>
            " nnoremap <buffer> gS :<C-u>LspWorkspaceSymbol<CR>
            " nnoremap <buffer> gQ :<C-u>LspDocumentFormat<CR>
            " vnoremap <buffer> gQ :LspDocumentRangeFormat<CR>
            nnoremap <buffer> K :<C-u>LspHover<CR>
            " nnoremap <buffer> <F1> :<C-u>LspImplementation<CR>
            " nnoremap <buffer> <F2> :<C-u>LspRename<CR>
            let g:lsp_diagnostics_enabled = 0
            let g:lsp_auto_enable = 1

            " let g:lsp_log_verbose = 1
            " let g:lsp_log_file = expand('~/vim-lsp.log')
        endfunction
    aug END
