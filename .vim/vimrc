command! FixWhitespace :%s/\\\@<!\s\+$//

command! -nargs=? Jq call s:Jq(<f-args>)
function! s:Jq(...)
    if 0 == a:0
        let l:arg = "."
    else
        let l:arg = a:1
    endif
    execute "%! jq --indent 4 \"" . l:arg . "\""
endfunction

