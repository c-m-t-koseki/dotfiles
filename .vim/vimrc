if g:plug.is_installed('lsp')
    aug Lsp
        au!
        if executable($HOME.'/virtualenv/vim/bin/pyls')
            au User lsp_setup call lsp#register_server({
                        \ 'name': 'pyls',
                        \ 'cmd': {server_info->[$HOME.'/virtualenv/vim/bin/pyls']},
                        \ 'whitelist': ['python'],
                        \ })
            au FileType python call s:configure_lsp() | call lsp#enable()
        endif
        if executable($HOME.'/src/github.com/cquery-project/cquery/build/release/bin/cquery')
            au User lsp_setup call lsp#register_server({
                      \ 'name': 'cquery',
                      \ 'cmd': {server_info->[$HOME.'/src/github.com/cquery-project/cquery/build/release/bin/cquery']},
