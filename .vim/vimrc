if g:plug.is_installed('lsp')
    aug Lsp
        au!
        if executable($HOME.'/.local/bin/pyls')
            au User lsp_setup call lsp#register_server({
                        \ 'name': 'pyls',
                        \ 'cmd': {server_info->[$HOME.'/.local/bin/pyls']},
                        \ 'whitelist': ['python'],
                        \ 'workspace_config': {'pyls': {'configurationSources': ['flake8']}},
                        \ })
            au FileType python call s:configure_lsp()
        endif
        if executable($HOME.'/src/github.com/cquery-project/cquery/build/release/bin/cquery')
            au User lsp_setup call lsp#register_server({
                        \ 'name': 'cquery',
                        \ 'cmd': {server_info->[$HOME.'/src/github.com/cquery-project/cquery/build/release/bin/cquery']},
                        \ 'root_uri': {server_info->lsp#utils#path_to_uri(lsp#utils#find_nearest_parent_file_directory(lsp#utils#get_buffer_path(), 'compile_commands.json'))},
                        \ 'initialization_options': { 'cacheDirectory': '/tmp/cquery/cache' },
                        \ 'whitelist': ['c', 'cpp', 'h'],
                        \ })
            au FileType c,cpp call s:configure_lsp()
        endif

        function! s:configure_lsp() abort
            setlocal omnifunc=lsp#complete
            setlocal signcolumn=yes
            nnoremap <silent> <buffer> <C-]> :<C-u>LspDefinition<CR>
            nnoremap <silent> <buffer> <C-w><C-]> :<C-u>LspPeekDefinition<CR>
            nnoremap <silent> <buffer> <C-n> :<C-u>LspNextError<CR>
            nnoremap <silent> <buffer> <C-p> :<C-u>LspPreviousError<CR>
            " nnoremap <silent> <buffer> gD :<C-u>LspReferences<CR>
            " nnoremap <buffer> gs :<C-u>LspDocumentSymbol<CR>
            " nnoremap <buffer> gS :<C-u>LspWorkspaceSymbol<CR>
            " nnoremap <buffer> gQ :<C-u>LspDocumentFormat<CR>
            " vnoremap <buffer> gQ :LspDocumentRangeFormat<CR>
            " nnoremap <buffer> <F1> :<C-u>LspImplementation<CR>
            nnoremap <buffer> K :<C-u>LspHover<CR>
            nnoremap <buffer> gr :<C-u>LspRename<CR>
            let g:lsp_diagnostics_enabled = 1
            let g:lsp_diagnostics_echo_cursor = 1
            let g:lsp_signs_error = {'text': '>>'}
            let g:lsp_signs_warning = {'text': '--'}
            let g:lsp_preview_float = 0
            let g:lsp_preview_doubletap = 0
            let g:lsp_hover_conceal = 1
            let g:lsp_signature_help_enabled = 0

            " let g:lsp_log_verbose = 1
            " let g:lsp_log_file = expand('~/vim-lsp.log')
            call lsp#enable()
        endfunction
    aug END
endif
