" keymap {{{
"" prefix
nmap <Space> [Space]
xmap <Space> [Space]
nnoremap [Space] <Nop>
xnoremap [Space] <Nop>

"" important
noremap : ;
noremap ; :
inoremap jk <Esc>
onoremap jk <Esc>
nnoremap [Space]. :<C-u>tabedit $MYVIMRC<CR>

"" tab
noremap gn gt
noremap gp gT
noremap gh <C-w>h
noremap gj <C-w>j
noremap gk <C-w>k
noremap gl <C-w>l
noremap gx <C-w>x
noremap <silent>g\| :rightbelow vnew<CR>
noremap <silent>g-  :rightbelow new<CR>
noremap <silent>gc  :tabnew<CR>

"" move
noremap [Space]h ^
noremap [Space]l $
inoremap <C-b> <Left>
cnoremap <C-b> <Left>
inoremap <C-f> <Right>
cnoremap <C-f> <Right>
inoremap <C-a> <Home>
cnoremap <C-a> <Home>
inoremap <C-e> <End>
cnoremap <C-e> <End>
cnoremap <C-d> <Del>

"" Nop
nnoremap ZZ <Nop>
nnoremap ZQ <Nop>
nnoremap Q <Nop>
nnoremap q: <Nop>
nnoremap q/ <Nop>
nnoremap q? <Nop>
noremap <Up> <Nop>
noremap <Down> <Nop>
noremap <Left> <Nop>
noremap <Right> <Nop>
noremap <C-n> :cne<CR>
noremap <C-p> :cpre<CR>

nnoremap <C-]> g<C-]> 

"" other
nnoremap <silent><Esc><Esc> :nohlsearch<CR>
" }}}

" options {{{
"" looks
set t_Co=256
set laststatus=2
set showmatch
set nowrap
set background=dark
if g:plug.is_installed('hybrid')
    colorscheme hybrid
endif
hi DiffAdd    cterm=bold ctermfg=10 ctermbg=17 gui=none guifg=bg guibg=Red
hi DiffDelete cterm=bold ctermfg=10 ctermbg=17 gui=none guifg=bg guibg=Red
hi DiffChange cterm=bold ctermfg=10 ctermbg=17 gui=none guifg=bg guibg=Red
hi DiffText   cterm=bold ctermfg=10 ctermbg=88 gui=none guifg=bg guibg=Red

"" tab string
set list
set listchars=tab:>-,trail:-,nbsp:%,extends:>,precedes:<

"" search
set incsearch
set hlsearch
set ignorecase
set smartcase
set nowrapscan

"" history
set hidden
set history=2000
set noswapfile
set nobackup

"" indent
set autoindent
set expandtab
set tabstop=4
set shiftwidth=4

"" other
set backspace=indent,start

set visualbell t_vb=

set wildmenu
set wildmode=longest:full,full

set encoding=utf-8
set fileencodings=ascii,iso-2022-jp,euc-jp,utf-8,sjis
" }}}

" plugin {{{
if g:plug.is_installed('caw')
    map <C-k> <Plug>(caw:hatpos:toggle)
endif

if g:plug.is_installed('fzf')
    nnoremap [Space]b :Buffers<CR>
    nnoremap [Space]x :Commands<CR>
    nnoremap [Space]f :GFiles<CR>
    nnoremap [Space]a :Ag 
    nnoremap [Space]r :History:<CR>
endif

if g:plug.is_installed('vim-over')
    nnoremap <silent>,/ :OverCommandLine<CR>%s/
    vnoremap <silent>,/ :OverCommandLine<CR>s/
endif
" }}}

command! FixWhitespace :%s/\\\@<!\s\+$//

syntax enable on
filetype plugin indent on

