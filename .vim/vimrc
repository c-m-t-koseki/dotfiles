" keymap {{{
"" prefix
nmap <Space> [Space]
xmap <Space> [Space]
nnoremap [Space] <Nop>
xnoremap [Space] <Nop>
set termwinkey=<C-A-T>

"" vimrc
nnoremap <silent>,e :<C-u>e $MYVIMRC<CR>
nnoremap <silent>,r :<C-u>source $MYVIMRC<CR>

"" important
noremap : ;
noremap ; :
inoremap jk <ESC>
onoremap jk <ESC>
nnoremap q; q:
nnoremap <silent><Esc><Esc> :nohlsearch<CR>
tnoremap g[ <C-\><C-n>

"" tab
noremap gn gt
noremap gp gT
noremap gh <C-w>h
noremap gj <C-w>j
noremap gk <C-w>k
noremap gl <C-w>l
noremap gx <C-w>x
noremap gs <C-w>s
noremap gv <C-w>v

"" move
noremap [Space]h ^
noremap [Space]l $
inoremap <C-b> <LEFT>
cnoremap <C-b> <LEFT>
inoremap <C-f> <RIGHT>
cnoremap <C-f> <RIGHT>
inoremap <C-a> <HOME>
cnoremap <C-a> <HOME>
inoremap <C-e> <END>
cnoremap <C-e> <END>
noremap n nzz
noremap N Nzz
noremap <C-n> :cne<CR>
noremap <C-p> :cpre<CR>

"" nop
nnoremap ZZ <NOP>
nnoremap ZQ <NOP>
nnoremap Q  <NOP>
" }}}

