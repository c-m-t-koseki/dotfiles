source $VIMRUNTIME/defaults.vim

" keymap {{{
"" prefix
nmap <Space> [Space]
xmap <Space> [Space]
nnoremap [Space] <Nop>
xnoremap [Space] <Nop>
set termwinkey=<C-A-T>

"" vimrc
nnoremap <silent>,e :<C-u>e $MYVIMRC<CR>
nnoremap <silent>,r :<C-u>source $MYVIMRC<CR>

"" important
noremap : ;
noremap ; :
inoremap jk <ESC>
onoremap jk <ESC>
nnoremap q; q:
nnoremap <silent><Esc><Esc> :nohlsearch<CR>
tnoremap g[ <C-\><C-n>

"" tab
noremap gn gt
noremap gp gT
noremap gh <C-w>h
noremap gj <C-w>j
noremap gk <C-w>k
noremap gl <C-w>l
noremap gx <C-w>x
noremap gs <C-w>s
noremap gv <C-w>v

"" move
noremap [Space]h ^
noremap [Space]l $
inoremap <C-b> <LEFT>
cnoremap <C-b> <LEFT>
inoremap <C-f> <RIGHT>
cnoremap <C-f> <RIGHT>
inoremap <C-a> <HOME>
cnoremap <C-a> <HOME>
inoremap <C-e> <END>
cnoremap <C-e> <END>
noremap n nzz
noremap N Nzz
noremap <C-n> :cne<CR>
noremap <C-p> :cpre<CR>

"" nop
nnoremap ZZ <NOP>
nnoremap ZQ <NOP>
nnoremap Q  <NOP>
" }}}

" options {{{
"" looks
set t_Co=256
set laststatus=2
set showmatch
set nowrap
set background=dark

let s:colors = split(globpath(&rtp, "colors/*.vim"), "\n")
if has('packages')
    let s:colors += split(globpath(&packpath, "pack/*/start/colors/*.vim"), "\n")
endif
let s:colors = map(uniq(s:colors), 'fnamemodify(v:val, ":t:r")')
for c in ['iceberg', 'hybrid', 'lucius', 'elflord']
    if count(s:colors, c)
        execute 'colorscheme ' . c
        break
    endif
endfor
"" vimdiff
" hi DiffAdd    cterm=bold ctermfg=10 ctermbg=17 gui=none guifg=bg guibg=Red
" hi DiffDelete cterm=bold ctermfg=10 ctermbg=17 gui=none guifg=bg guibg=Red
" hi DiffChange cterm=bold ctermfg=10 ctermbg=17 gui=none guifg=bg guibg=Red
" hi DiffText   cterm=bold ctermfg=10 ctermbg=88 gui=none guifg=bg guibg=Red
"" status line
let s:modemap = {
            \ 'n':  'NORMAL',
            \ 'i':  'INSERT',
            \ 'v':  'VISUAL',
            \ 'V':  'V-LINE',
            \ '': 'V-BLOCK',
            \ 'R':  'REPLACE',
            \ 'c':  'COMMAND',
            \ 't':  'TERMINAL',
            \ }
function! Statusline_mode()
    return get(s:modemap, mode(1), 'None' . mode(1))
endfunction
function! Statusline_mode2()
    let l:mode = get(s:modemap, mode(1), {'t': 'a', 'c':'statusline'})
    let l:stl = '%#SL' . l:mode.c . '# ' . l:mode.t . ' %0* '
    let l:stl = l:stl . '%f%=%{&ft} %{&enc}[%{&ff}] '
    let l:stl = l:stl . '☰ %4l/%L:%3c'
    return l:stl
endfunction
set statusline=\ %{Statusline_mode()}\ %t%m%r

"" tab string
set list
set listchars=tab:>-,trail:-,nbsp:%,extends:>,precedes:<

"" search
set incsearch
set hlsearch
set ignorecase
set smartcase
set nowrapscan

"" history
set history=2000
set noswapfile
set nobackup

"" complete
set isfname-==
set completeopt=menuone,noinsert,noselect
set dict=/usr/share/dict/words

"" indent
set autoindent
set expandtab
set tabstop=4
set shiftwidth=4
set softtabstop=4

"" other
set backspace=indent,start
set visualbell t_vb=
set wildmenu
set wildmode=longest:full,full
set encoding=utf-8
set fileencodings=ascii,iso-2022-jp,euc-jp,utf-8,sjis
set hidden
set mouse=
" }}}

" plugin {{{
if "caw"
    map <C-k> <Plug>(caw:hatpos:toggle)
endif

if "easy-align"
    let g:easy_align_delimiters={'\\': {'pattern': '\\'}}
    xmap g= <Plug>(EasyAlign)
    xmap g\ <Plug>(EasyAlign)- 
endif

if "fzf"
    nnoremap <silent>[Space]b :<C-u>Buffers<CR>
    nnoremap <silent>[Space]x :<C-u>Commands<CR>
    nnoremap <silent>[Space]f :<C-u>GFiles<CR>
    nnoremap <silent>[Space]F :<C-u>Files<CR>
    nnoremap <silent>[Space]r :<C-u>History:<CR>
    nnoremap <silent>[Space]a :<C-u>call fzf#vim#ag('', {'options': '--bind alt-enter:select-all+accept'})<CR>
    nnoremap <silent>[Space]/ :<C-u>call fzf#vim#buffer_lines('', {'options': '--bind alt-enter:select-all+accept'})<CR>
endif

if "quickrun"
    nnoremap <silent>[Space]i :QuickRun -mode n<CR>
    vnoremap <silent>[Space]i :QuickRun -mode v<CR>
    let g:quickrun_no_default_key_mappings = 1
    let g:quickrun_config = {
                \   "_" : {
                \       "outputter/buffer/split" : ":botright",
                \       "outputter/buffer/close_on_empty" : 1
                \   },
                \}
endif


if 'asyncomplete'
    let g:asyncomplete_auto_completeopt = 0
endif

if "lsp"
    aug Lsp
        au!
        if executable($HOME.'/virtualenv/vim/bin/pyls')
            au User lsp_setup call lsp#register_server({
                        \ 'name': 'pyls',
                        \ 'cmd': {server_info->[$HOME.'/virtualenv/vim/bin/pyls']},
                        \ 'whitelist': ['python'],
                        \ })
            au FileType python call s:configure_lsp()
        endif

        function! s:configure_lsp() abort
            setlocal omnifunc=lsp#complete
            nnoremap <silent> <buffer> <C-]> :<C-u>LspDefinition<CR>zz
            nnoremap <silent> <buffer> <C-w><C-]> :<C-u>sp<CR>:LspDefinition<CR>
            " nnoremap <silent> <buffer> <C-n> :<C-u>LspNextError<CR>
            " nnoremap <silent> <buffer> <C-p> :<C-u>LspPreviousError<CR>
            nnoremap <silent> <buffer> gD :<C-u>LspReferences<CR>
            " nnoremap <buffer> gs :<C-u>LspDocumentSymbol<CR>
            " nnoremap <buffer> gS :<C-u>LspWorkspaceSymbol<CR>
            " nnoremap <buffer> gQ :<C-u>LspDocumentFormat<CR>
            " vnoremap <buffer> gQ :LspDocumentRangeFormat<CR>
            nnoremap <buffer> K :<C-u>LspHover<CR>
            " nnoremap <buffer> <F1> :<C-u>LspImplementation<CR>
            " nnoremap <buffer> <F2> :<C-u>LspRename<CR>
            let g:lsp_diagnostics_enabled = 0
            let g:lsp_auto_enable = 1

            packadd vim-lsp
            packadd asyncomplete.vim
            packadd asyncomplete-lsp.vim

            " let g:lsp_log_verbose = 1
            " let g:lsp_log_file = expand('~/vim-lsp.log')
        endfunction
    aug END
endif
" }}}

command! FixWhitespace :%s/\\\@<!\s\+$//

command! -nargs=? Jq call s:Jq(<f-args>)
function! s:Jq(...)
    if 0 == a:0
        let l:arg = "."
    else
        let l:arg = a:1
    endif
    execute "%! jq \"" . l:arg . "\""
endfunction

set secure
