" keymap {{{
"" prefix
nmap <Space> [Space]
xmap <Space> [Space]
nnoremap [Space] <Nop>
xnoremap [Space] <Nop>
set termwinkey=<C-A-T>

"" vimrc
nnoremap <silent>,e :<C-u>e $MYVIMRC<CR>
nnoremap <silent>,r :<C-u>source $MYVIMRC<CR>

"" important
noremap : ;
noremap ; :
inoremap jk <ESC>
onoremap jk <ESC>
nnoremap q; q:
nnoremap <silent><Esc><Esc> :nohlsearch<CR>
tnoremap g[ <C-\><C-n>

"" tab
noremap gn gt
noremap gp gT
noremap gh <C-w>h
noremap gj <C-w>j
noremap gk <C-w>k
noremap gl <C-w>l
noremap gx <C-w>x
noremap gs <C-w>s
noremap gv <C-w>v

"" move
noremap [Space]h ^
noremap [Space]l $
inoremap <C-b> <LEFT>
cnoremap <C-b> <LEFT>
inoremap <C-f> <RIGHT>
cnoremap <C-f> <RIGHT>
inoremap <C-a> <HOME>
cnoremap <C-a> <HOME>
inoremap <C-e> <END>
cnoremap <C-e> <END>
noremap n nzz
noremap N Nzz
noremap <C-n> :cne<CR>
noremap <C-p> :cpre<CR>

"" nop
nnoremap ZZ <NOP>
nnoremap ZQ <NOP>
nnoremap Q  <NOP>
" }}}

" options {{{
"" looks
set t_Co=256
set laststatus=2
set showmatch
set nowrap
set background=dark
silent! colorscheme elflord
if g:plug.is_installed('hybrid')
            \ && 0
    silent! colorscheme hybrid
endif
if g:plug.is_installed('iceberg')
    silent! colorscheme iceberg
endif
"" vimdiff
hi DiffAdd    cterm=bold ctermfg=10 ctermbg=17 gui=none guifg=bg guibg=Red
hi DiffDelete cterm=bold ctermfg=10 ctermbg=17 gui=none guifg=bg guibg=Red
hi DiffChange cterm=bold ctermfg=10 ctermbg=17 gui=none guifg=bg guibg=Red
hi DiffText   cterm=bold ctermfg=10 ctermbg=88 gui=none guifg=bg guibg=Red

"" tab string
set list
set listchars=tab:>-,trail:-,nbsp:%,extends:>,precedes:<

"" search
set incsearch
set hlsearch
set ignorecase
set smartcase
set nowrapscan

"" history
set history=2000
set noswapfile
set nobackup

"" complete
set isfname-==
set completeopt=menuone,noinsert,noselect
set dict=/usr/share/dict/words

"" indent
set autoindent
set expandtab
set tabstop=4
set shiftwidth=4
set softtabstop=4

"" other
set backspace=indent,start
set visualbell t_vb=
set wildmenu
set wildmode=longest:full,full
set encoding=utf-8
set fileencodings=ascii,iso-2022-jp,euc-jp,utf-8,sjis
set hidden
" }}}

" plugin {{{
