" keymap {{{
"" prefix
nmap <Space> [Space]
xmap <Space> [Space]
nnoremap [Space] <Nop>
xnoremap [Space] <Nop>
set termwinkey=<C-A-T>

"" vimrc
nnoremap <silent>,e :<C-u>e $MYVIMRC<CR>
nnoremap <silent>,r :<C-u>source $MYVIMRC<CR>

"" important
noremap : ;
noremap ; :
inoremap jk <ESC>
onoremap jk <ESC>
nnoremap q; q:
nnoremap <silent><Esc><Esc> :nohlsearch<CR>
tnoremap <ESC> <C-\><C-n>

"" tab
noremap gn gt
noremap gp gT
noremap gh <C-w>h
noremap gj <C-w>j
noremap gk <C-w>k
noremap gl <C-w>l
noremap gx <C-w>x
noremap gs <C-w>s
noremap gv <C-w>v

"" move
noremap [Space]h ^
noremap [Space]l $
inoremap <C-b> <LEFT>
cnoremap <C-b> <LEFT>
inoremap <C-f> <RIGHT>
cnoremap <C-f> <RIGHT>
inoremap <C-a> <HOME>
cnoremap <C-a> <HOME>
inoremap <C-e> <END>
cnoremap <C-e> <END>
noremap n nzz
noremap N Nzz
noremap <C-n> :cne<CR>
noremap <C-p> :cpre<CR>

"" nop
nnoremap ZZ <NOP>
nnoremap ZQ <NOP>
nnoremap Q  <NOP>
" }}}

" options {{{
"" looks
set t_Co=256
set laststatus=2
set showmatch
set nowrap
set background=dark
silent! colorscheme elflord
if g:plug.is_installed('hybrid')
            \ && 0
    silent! colorscheme hybrid
    "" 背景透過 autocmdによって別のスキーマにしても反映される
    aug Color
        au!
        au ColorScheme * hi! Normal      ctermbg=NONE guibg=NONE
        au ColorScheme * hi! NonText     ctermbg=NONE guibg=NONE
        au ColorScheme * hi! LineNr      ctermbg=NONE guibg=NONE
        au ColorScheme * hi! Folded      ctermbg=NONE guibg=NONE
        au ColorScheme * hi! EndOfBuffer ctermbg=NONE guibg=NONE
    aug END
endif
if g:plug.is_installed('iceberg')
    silent! colorscheme iceberg
endif
if g:plug.is_installed('lightline')
    let g:lightline = {'colorscheme': 'Tomorrow'}
endif
"" vimdiff
hi DiffAdd    cterm=bold ctermfg=10 ctermbg=17 gui=none guifg=bg guibg=Red
hi DiffDelete cterm=bold ctermfg=10 ctermbg=17 gui=none guifg=bg guibg=Red
hi DiffChange cterm=bold ctermfg=10 ctermbg=17 gui=none guifg=bg guibg=Red
hi DiffText   cterm=bold ctermfg=10 ctermbg=88 gui=none guifg=bg guibg=Red

"" tab string
set list
set listchars=tab:>-,trail:-,nbsp:%,extends:>,precedes:<

"" search
set incsearch
set hlsearch
set ignorecase
set smartcase
set nowrapscan

"" history
set hidden
set history=2000
set noswapfile
set nobackup

"" indent
set autoindent
set expandtab
set tabstop=4
set shiftwidth=4

"" other
set backspace=indent,start

set visualbell t_vb=

set wildmenu
set wildmode=longest:full,full

set encoding=utf-8
set fileencodings=ascii,iso-2022-jp,euc-jp,utf-8,sjis
" }}}

" plugin {{{
if g:plug.is_installed('caw')
    map <C-k> <Plug>(caw:hatpos:toggle)
endif

if g:plug.is_installed('fzf')
    nnoremap [Space]b :Buffers<CR>
    nnoremap [Space]x :Commands<CR>
    nnoremap [Space]f :GFiles<CR>
    nnoremap [Space]a :Ag 
    nnoremap [Space]r :History:<CR>
endif

if g:plug.is_installed('vim-over')
    nnoremap <silent>,/ :OverCommandLine<CR>%s/
    vnoremap <silent>,/ :OverCommandLine<CR>s/
endif
" }}}

