#!/bin/bash
set -e

# sudo apt install -y libxt-dev libgtk-3-dev

./configure                        \
    --enable-fail-if-missing       \
    --with-features=huge           \
    --enable-pythoninterp=dynamic  \
    --enable-python3interp=dynamic \
    --enable-conceal               \
    # --enable-gui=gtk3              \
    # --with-x=yes                   \


make -j8

# sudo apt purge -y libxt-dev libgtk-3-dev
# sudo apt auto-remove
