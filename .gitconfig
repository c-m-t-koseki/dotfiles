[user]
  name = t-koseki
  email = t-koseki@morphoinc.com
[color]
  status = auto
  diff = auto
  branch = auto
  grep = auto
[alias]
  st = status
  ad = add
  cm = commit -m
  bn = branch
  co = checkout
  cob = checkout -b
  sh = stash -u
  shp = stash pop
  cancel = reset --soft HEAD~
  back = reset --hard HEAD~
  lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
[core]
  editor = vim
  excludesfile = ~/dotfiles/.gitignore
  quotepath = false
[push]
  default = simple
[pull]
  rebase = preserve
[merge]
  ff = false
[ghq]
  root = ~/src
[ghq "ssh://git@github.morpho.local/"]
  vcs = git
[ghq "https://ec2-52-198-151-12.ap-northeast-1.compute.amazonaws.com"]
  vcs = git
